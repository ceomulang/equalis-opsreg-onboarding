{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Grants Equalis OpsReg read-only access to this Azure subscription for compliance monitoring across GDPR, ISO 27001, NIS2, DORA, and PCI-DSS frameworks. Three built-in roles are assigned: Reader, Security Reader, and Cost Management Reader. No resources are created. No infrastructure is modified. Equalis OpsReg is an inform-only platform — it detects compliance violations and provides remediation guidance but never changes your environment.",
    "author": "Equalis OpsReg Ltd",
    "version": "1.0.0"
  },
  "variables": {
    "opsregAppId": "bd96ea0c-27f5-473e-b38b-8422eeb19fab",
    "readerRoleId": "acdd72a7-3385-48ef-bd42-f606fba81ae7",
    "securityReaderRoleId": "39bc4728-0917-49c7-9d2c-d95423bc2eb4",
    "costManagementReaderRoleId": "72fafb9e-0641-4937-9268-a91bfd8191a3",
    "readerAssignmentId": "[guid(subscription().subscriptionId, variables('readerRoleId'), variables('opsregAppId'))]",
    "securityReaderAssignmentId": "[guid(subscription().subscriptionId, variables('securityReaderRoleId'), variables('opsregAppId'))]",
    "costReaderAssignmentId": "[guid(subscription().subscriptionId, variables('costManagementReaderRoleId'), variables('opsregAppId'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[variables('readerAssignmentId')]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('readerRoleId'))]",
        "principalId": "[variables('opsregAppId')]",
        "principalType": "ServicePrincipal",
        "description": "Equalis OpsReg — Reader access for compliance scanning via Azure Resource Graph"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[variables('securityReaderAssignmentId')]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('securityReaderRoleId'))]",
        "principalId": "[variables('opsregAppId')]",
        "principalType": "ServicePrincipal",
        "description": "Equalis OpsReg — Security Reader for Microsoft Defender for Cloud posture data"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[variables('costReaderAssignmentId')]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('costManagementReaderRoleId'))]",
        "principalId": "[variables('opsregAppId')]",
        "principalType": "ServicePrincipal",
        "description": "Equalis OpsReg — Cost Management Reader for FinOps spend analysis"
      }
    }
  ],
  "outputs": {
    "subscriptionId": {
      "type": "string",
      "value": "[subscription().subscriptionId]"
    },
    "tenantId": {
      "type": "string",
      "value": "[subscription().tenantId]"
    }
  }
}
